<div class="modal-launcher" data-controller="modal">
  <button type="button" class="button button--primary" data-action="click->modal#open">
    写真を登録
  </button>

  <dialog class="modal" data-modal-target="dialog" aria-labelledby="register-photo-title" data-action="click->modal#backdropClose">
    <div class="modal__panel">
      <div class="modal__header">
        <div>
          <p class="eyebrow">Photo upload</p>
          <h2 id="register-photo-title">写真登録モーダル</h2>
        </div>
        <button type="button" class="icon-button" aria-label="モーダルを閉じる" data-action="click->modal#close">×</button>
      </div>

      <div class="modal__body">
        <div class="form-grid">
          <label class="field">
            <span>タイトル</span>
            <input type="text" value="New morning shot" placeholder="写真タイトル">
          </label>

          <label class="field">
            <span>撮影メモ</span>
            <textarea rows="4" placeholder="写真の説明を入力"></textarea>
          </label>

          <label class="field">
            <span>公開範囲</span>
            <select>
              <option>全体に公開</option>
              <option>フォロワー限定</option>
              <option>自分のみ</option>
            </select>
          </label>
        </div>

        <div class="modal__hint">
          <p>この段階では保存処理はありません。入力UIと閉じる動作だけを確認できます。</p>
        </div>
      </div>

      <div class="modal__actions">
        <button type="button" class="button button--ghost" data-action="click->modal#close">キャンセル</button>
        <button type="button" class="button button--primary">下書き保存</button>
      </div>
    </div>
  </dialog>
</div>
